# Frontend Environment Variables (Vite)
#
# 1. Local Development or Render Single-Service Deployment:
# Leave blank (Vite proxy and same-origin Express handling will be used automatically)
VITE_API_BASE_URL=

# 2. Vercel Deployment (Frontend on Vercel + Backend on Render):
# Set this in your Vercel Dashboard -> Settings -> Environment Variables:
# VITE_API_BASE_URL=https://your-backend-app.onrender.com
